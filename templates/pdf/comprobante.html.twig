<html>
    <head>
        <meta charset="UTF-8">
        <title>Factura</title>
    </head>
    <style>

    table {
      font-family: Helvetica, Sans-Serif;
      border-collapse: collapse;
      width: 100%;
    }
    /* TABLE HEADER */
    .table-header td, .table-header th {
      border: 1px solid #dddddd;
      padding: 8px;
    }

    .table-header tr th{
      border: 1px solid #dddddd;
      width:5%;
      font-size: 25px
      border: 1px solid;
      text-align:center;
    }

    /* TABLE EMISOR */
    .table-emisor td, .table-emisor th {
        padding: 8px;
    }
    .table-emisor tr .emisor{
        width:45%;
        font-size:20px;
        border-left: 1px solid #dddddd;
    }
    .table-emisor tr .codigo{
        width:10%;
        text-align:center;
        border: 1px solid #dddddd;

    }
    .table-emisor tr .codigo .valor{
        font-size:28px;
    }
    .table-emisor tr .codigo .descripcion{
        font-size:10px;
    }
    .table-emisor tr .factura{
        width:45%;
        text-align:center;
        padding-left: 25px;
        font-size:25px;
        border-right: 1px solid #dddddd;
    }

    /* TABLE DATA EMISOR */
    .table-data-emisor td, .table-data-emisor th {
        padding: 8px;
    }
    .table-data-emisor tr .emisor{
      width: 50%;
      border-right: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
      text-align:left;
    }
    .table-data-emisor tr .factura{
        width: 50%;
        text-align:left;
        border-right: 1px solid #dddddd;
        border-bottom: 1px solid #dddddd;
        padding-left: 25px;
    }
    /* TABLE PERIODO */
    .table-periodo td, .table-periodo th {
        padding: 8px;
    }
    .table-periodo tr {
      border-right: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
    }

    /* TABLE RECEPTOR */
    .table-receptor td, .table-receptor th {
        padding: 8px;
    }
    .table-receptor tr .documentos{
      width: 40%;
      border-top: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
      text-align:left;
    }
    .table-receptor tr .personales{
        width: 60%;
        text-align:right;
        border-top: 1px solid #dddddd;
        border-right: 1px solid #dddddd;
        border-bottom: 1px solid #dddddd;
    }

    /* TABLE PRODUCTOS */
    .table-productos .cabecera {
      background-color: #dddddd;
    }
    .table-productos td, .table-productos th {
        padding: 8px;
        border: 1px solid #dddddd;
    }
    .table-productos td{
      text-align: center;
    }

    footer {
      position: absolute;
      bottom: 0;
      width: 100%;
    }

    footer .montos{
      border:1px solid #dddddd;
      padding: 15px;
    }
    footer .recibo{
      position: absolute;
      border-top:1px solid #dddddd;
      padding: 15px;
    }

    </style>
    <body>
    {% set url = path_public ~'/uploads/'~ cliente.getNegocio.getLogo() %}
    {% set recibo = (CbteTipo.getAfipId == recibo) %}
    {% set titulos = (CbteTipo.getAfipId == recibo) ? ['ORIGINAL'] : ['ORIGINAL','DUPLICADO','TRIPLICADO'] %}

    {% for key, titulo in titulos %}

    <div>
    {# HEADER TITLE : ORIGINAL O DUPLICADO #}
    <table class="table-header">
    <tr>
      <th>{{titulo}}</th>
    </tr>
    </table>
    {# DATOS DE EMISOR #}
    <table class="table-emisor">
      <tr>
        {% if cliente.getNegocio().getLogo() is not empty %}
        <th class="emisor"><img width="" height="50" src="{{path_public}}/uploads/{{cliente.getNegocio.getLogo()}}" ></th>
        {% else %}
        <th class="emisor">{{cliente.getNegocio.getRazonSocial}}</th>
        {% endif %}
        <th class="codigo">
          <span class="valor">{{CbteTipo.getCodigo()}}</span><br>
          <span class="descripcion">{{recibo ? "" : "COD ." ~ CbteTipo.getAfipFactura()}}</span>
        </th>
        <th class="factura">
            {{CbteTipo.getDescripcion() | upper}}
            {% if recibo %}
            <br><span style="font-size:10px; color:grey">Documento no válido como factura</span>
            {% endif %}
        </th>
      </tr>
    </table>

    {# INFO DATOS EMISOR #}
    <table class="table-data-emisor">
      <tr>
        <td class="emisor">

          <span style="font-size:13px; font-weight: bold;">Razón Social:</span><span style="font-size:12px"> {{cliente.getNegocio().getRazonSocial()}} </span><br><br>
          <span style="font-size:13px; font-weight: bold;">Domicilio Comercial:</span><span style="font-size:12px"> {{cliente.getNegocio().getDireccion() }} - {{cliente.getNegocio().getLocalidad().getDescripcion()|upper}} , {{cliente.getNegocio().getLocalidad().getProvincia().getDescripcion()}}</span><br>
          {% if not recibo %}
          <span style="font-size:13px; font-weight: bold;">Condición IVA:</span><span style="font-size:12px; font-weight: bold">  {{cliente.getNegocio().getCondicionIva() ? cliente.getNegocio().getCondicionIva().getDescripcion() : '--'}}</span>
          {% endif %}
        </td>
        <td class="factura">
        {% if not recibo %}
          <span style="font-size:13px; font-weight: bold;">Punto de Venta:</span><span style="font-size:12px"> {{cliente.getNegocio().getPtoVtaFactura()}}</span>
          <span style="font-size:13px; font-weight: bold;">Comp. Nro:</span><span style="font-size:12px"> {{comp.getNumero()}}</span><br>
          <span style="font-size:13px; font-weight: bold;">Ingresos Brutos:</span><span style="font-size:12px;"> {{cliente.getNegocio().getIibb() ?? '-'}}</span><br>
          <span style="font-size:13px; font-weight: bold;">Fecha de Inicio de Actividades:</span><span style="font-size:12px;"> {{cliente.getNegocio().getInicioActividad() ?  cliente.getNegocio().getInicioActividad() | date('d/m/Y') : '-'}}</span><br>
        {% endif %}
          <span style="font-size:13px; font-weight: bold;">Fecha de Emisión:</span><span style="font-size:12px"> {{CbteFch | date('y/m/d')}} </span><br><br>
          <span style="font-size:13px; font-weight: bold;">CUIT:</span><span style="font-size:12px;"> {{cliente.getNegocio().getCuitCuil()}}</span><br>
        </td>
      </tr>
    </table>
    {# PERIODO FACTURADO #}
    {% if not recibo %}
    <table class="table-periodo">
      <tr>
        <td style="border-left: 1px solid #dddddd;border-bottom: 1px solid #dddddd;"><span style="font-size:13px; font-weight: bold;">Periodo Facturado Desde: </span><span style="font-size:13px;">{{FchServDesde ?? '-'}}</span></td>
        <td style="border-bottom: 1px solid #dddddd;"><span style="font-size:13px; font-weight: bold;">Hasta: </span><span style="font-size:13px;">{{FchServHasta ?? '-'}}</span></td>
        <td style="border-right: 1px solid #dddddd;border-bottom: 1px solid #dddddd;"><span style="font-size:13px; font-weight: bold;">Fecha de Vto para el pago: </span><span style="font-size:13px;">{{FchVtoPago ?? '-'}}</span></td>
      </tr>
    </table>
    {% endif %}
    {# DATOS RECEPTOR #}
    {# INFO DATOS EMISOR #}
    {#  background-color: #dddddd; #}
    <table class="table-receptor" style="margin-top:2px">
      <tr>
        <td class="documentos">
          <span style="font-size:13px; font-weight: bold;">{{cliente.getDocumento() == 0 ? 'Documento' : cliente.getTipoDocumento().getDescripcion()}}:</span><span style="font-size:12px"> {{cliente.getDocumento}}</span><br><br>
          {% if not recibo %}
          <span style="font-size:13px; font-weight: bold;">Condición IVA:</span><span style="font-size:12px;"> {{cliente.getCondicionIva().getDescripcion()}}</span><br>
          <span style="font-size:13px; font-weight: bold;">Condición de venta:</span><span style="font-size:12px"> {{CondVta.getDescripcion()}}</span><br>
          {% endif %}
        </td>
        <td class="personales">
          <span style="text-align:right;font-size:13px; font-weight: bold;">Razón Social:</span><span style="font-size:12px"> {{cliente.getRazonSocial | upper}}</span> <br><br>
          <span style="text-align:right;font-size:13px; font-weight: bold;">Domicilio:</span><span style="font-size:12px">  {{cliente.getDireccion() }} - {{cliente.getLocalidad().getDescripcion()|upper}} , {{cliente.getLocalidad().getProvincia().getDescripcion()}}</span><br>
        </td>
      </tr>
    </table>

      {# LISTADO PRODUCTOS #}
      <table class="table-productos" style="margin-top:2px">
        <tr class="cabecera">
          <th style="font-size:10px;">Código</th>
          <th style="font-size:10px;">Producto / Servicio</th>
          <th style="font-size:10px;">Cantidad</th>
          <th style="font-size:10px;">Precio Unit.</th>
          <th style="font-size:10px;">% Bonif</th>
          <th style="font-size:10px;">Imp. Bonif.</th>
          {% if CbteTipo.getAfipId() == 1 %}
            <th style="font-size:10px;">Alicuota Iva</th>
            <th style="font-size:10px;">Total</th>
          {% else %}
            <th style="font-size:10px;">Subtotal</th>
          {% endif %}
        </tr>
        {% for producto in productos %}
        <tr>
          <td style="font-size:10px;">{{producto.producto.codigo ?? '-'}}</td>
          <td style="font-size:10px;">{{producto.producto.descripcion}}</td>
          <td style="font-size:10px;">{{producto.cantidad | number_format(2, ',', '.') }}</td>
          <td style="font-size:10px;">{{producto.precio_unitario | number_format(2, ',', '.')}}</td>
          <td style="font-size:10px;">{{producto.bonificacion | number_format(2, ',', '.')}}</td>
          <td style="font-size:10px;">{{producto.monto_bonif | number_format(2, ',', '.')}}</td>
          {% if CbteTipo.getAfipId() == 1 %}
            <td style="font-size:10px;">{{producto.tipo_alicuota.descripcion}}</td>
          {% endif %}
          <td style="font-size:10px;">{{producto.subtotal | number_format(2, ',', '.')}}</td>
        </tr>
      {% endfor %}
      </table>
  {% if not recibo %}
    <footer style="height: {{CbteTipo.getAfipId() == 1 ? 300 : 200}}px">
      <div class="montos">
      <table>
        <tr>
          <td style="width:25%"></td>
          <td style="width:25%"></td>
          <td style="width:35%;text-align:right;">


            {# factura A #}
            {% if CbteTipo.getAfipId() == 1 %}
            <span style="font-size:13px; font-weight: bold;">Importe Neto no Gravado:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe Exento:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe Neto Gravado:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 0%:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 2.5%:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 5%:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 10.5%:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 21%:$</span><br>
            <span style="font-size:13px; font-weight: bold;">Importe IVA 27%:$</span><br>
            {% endif %}
            <span style="font-size:13px; font-weight: bold;">Importe Total:$</span>
          </td>

          <td style="width:15%;text-align:right;margin-bottom:-60px;">
          {# importes factura A #}
          {% if CbteTipo.getAfipId() == 1 %}
          <span style="font-size:13px;">{{ImpTotConc | number_format(2, ',', '.') }}</span><br>
          <span style="font-size:13px;">{{ImpOpEx | number_format(2, ',', '.')}}</span><br>
          <span style="font-size:13px;">{{ImpNeto | number_format(2, ',', '.')}}</span><br>
          <span style="font-size:13px;">{{(Iva.ali3.Importe ?? 0 )| number_format(2, ',', '.') }}</span><br>
          <span style="font-size:13px;">{{(Iva.ali9.Importe ?? 0 )| number_format(2, ',', '.') }}</span><br>
          <span style="font-size:13px;">{{(Iva.ali8.Importe ?? 0 )| number_format(2, ',', '.') }}</span><br>
          <span style="font-size:13px;">{{(Iva.ali4.Importe ?? 0 )| number_format(2, ',', '.')}}</span><br>
          <span style="font-size:13px;">{{(Iva.ali5.Importe ?? 0 )| number_format(2, ',', '.') }}</span><br>
          <span style="font-size:13px;">{{(Iva.ali6.Importe ?? 0 )| number_format(2, ',', '.') }}</span><br>
          {% endif %}
          <span style="font-size:13px;">{{ImpTotal | number_format(2, ',', '.')}}</span>
          </td>
        </tr>
      </table>
      </div>
        <div style="margin-top:1px">
            <table >
              <tr>
                  <td style="width:33%;  text-align: left;"><img src="{{ path_public ~ '/build/images/afip.png'}}"><br>
                  <img src="{{codigoBarras}}" width="120%" height="12%"><br>
                  <p style="font-size:12px; margin-left:40px; margin-top:0">{{codigo}}</p>
                  </td>
                  <th style="width:10% ;text-align: left;
                            padding-left:15px;">
                      <span>Pág 1/{{key + 1}}</span>
                  </th>
                  <th style="width:20%; font-size: 15px;text-align: right;"><span>CAE N°: </span><br>
                                                                            <span>Fecha de Vto. de CAE: </span></th>
                  <td style="width:16%; font-size: 16px;text-align: left;"><span>{{cae.CAE}}</span><br>
                                                                            <span>{{cae.CAEFchVto | date('d/m/Y')}}</span><br></td>
              </tr>
            </table>
        </div>

      </footer>
        {% if titulo != 'TRIPLICADO' %}
        <div style="page-break-after: always"></div>
        {% endif %}
      </div>
      {% else %}
        <footer style="height: 10px">
          <div class="recibo">
          <table>
            <tr>
              <td style="width:25%"></td>
              <td style="width:25%"></td>
              <td style="width:35%;text-align:right;">
                <span style="font-size:13px; font-weight: bold;">Importe Total:</span>
              </td>

              <td style="width:15%;text-align:center;margin-bottom:-60px;">
              <span style="font-size:13px;">$ {{ImpTotal | number_format(2, ',', '.')}}</span>
              </td>
            </tr>
          </table>
          </footer>
      {% endif %}
    {% endfor %}
    </body>
</html>
