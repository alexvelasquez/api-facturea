    <style>
    table {
      font-family: Helvetica, Sans-Serif;
      border-collapse: collapse;
      width: 100%;
    }
    /* TABLE HEADER */
    .table-header td, .table-header th {
      border: 1px solid #dddddd;
      padding: 8px;
    }

    .table-header tr th{
      border: 1px solid #dddddd;
      width:5%;
      font-size: 25px
      border: 1px solid;
      text-align:center;
    }

    /* TABLE EMISOR */
    .table-emisor td, .table-emisor th {
        padding: 8px;
    }
    .table-emisor tr .emisor{
        width:45%;
        font-size:20px;
        border-left: 1px solid #dddddd;
    }
    .table-emisor tr .codigo{
        width:10%;
        text-align:center;
        border: 1px solid #dddddd;

    }
    .table-emisor tr .codigo .valor{
        font-size:25px;
    }
    .table-emisor tr .codigo .descripcion{
        font-size:10px;
    }
    .table-emisor tr .factura{
        width:45%;
        text-align:left;
        padding-left: 25px;
        font-size:25px;
        border-right: 1px solid #dddddd;
    }

    /* TABLE DATA EMISOR */
    .table-data-emisor td, .table-data-emisor th {
        padding: 8px;
    }
    .table-data-emisor tr .emisor{
      width: 50%;
      border-right: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
      text-align:left;
    }
    .table-data-emisor tr .factura{
        width: 50%;
        text-align:left;
        border-right: 1px solid #dddddd;
        border-bottom: 1px solid #dddddd;
        padding-left: 25px;
    }
    /* TABLE PERIODO */
    .table-periodo td, .table-periodo th {
        padding: 8px;
    }
    .table-periodo tr {
      border-right: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
    }

    /* TABLE RECEPTOR */
    .table-receptor td, .table-receptor th {
        padding: 8px;
    }
    .table-receptor tr .documentos{
      width: 40%;
      border-top: 1px solid #dddddd;
      border-left: 1px solid #dddddd;
      border-bottom: 1px solid #dddddd;
      text-align:left;
    }
    .table-receptor tr .personales{
        width: 60%;
        text-align:left;
        border-top: 1px solid #dddddd;
        border-right: 1px solid #dddddd;
        border-bottom: 1px solid #dddddd;
    }

    /* TABLE PRODUCTOS */
    .table-productos .cabecera {
      background-color: #dddddd;
    }
    .table-productos td, .table-productos th {
        padding: 8px;
        border: 1px solid #dddddd;
    }
    .table-productos td{
      text-align: center;
    }

    footer {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 300px;
    }

    footer .montos{
      border:1px solid #dddddd;
      padding: 15px
    }

    </style>
