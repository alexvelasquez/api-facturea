<html>
    <head>
        <meta charset="UTF-8">
        <title>Pedido</title>
    </head>
    <style>
    table {
      font-family: Helvetica, Sans-Serif;
      border-collapse: collapse;
      width: 100%;
    }
    /* TABLE HEADER */
    .table-header td, .table-header th {
      padding: 8px;
    }

    .table-header tr th{
      width:5%;
      font-size: 25px
      border: 1px solid;
      text-align:center;
    }

    /* TABLE PRODUCTOS */
    .table-productos .cabecera {
      background-color: #dddddd;
    }
    .table-productos td, .table-productos th {
        padding: 8px;
        border: 1px solid #dddddd;
    }
    .table-productos td{
      text-align: center;
    }


    </style>
    <body>
    {# HEADER TITLE : ORIGINAL O DUPLICADO #}
    <table class="table-header">
      <tr>
        <th style="text-align:center"><img src="{{absolute_url(asset('build/images/logo.png'))}}"></img><p style="font-size:12px">www.facturea.com.ar</p></th>
        <th style="text-align:center">PEDIDO</th>
        <th style="text-align:center"><span style="font-size:15px">{{venta.getFVenta | date('d/m/Y')}}</span> <br>
            <span style="font-size:12px">CLIENTE: {{venta.getCliente.getRazonSocial}}</span>
        </th>
      </tr>
    </table>

    {# LISTADO PRODUCTOS #}
    {#  background-color: #dddddd; #}
    <table class="table-productos" style="margin-top:2px">
      <tr class="cabecera">
        <th style="font-size:10px;">Código</th>
        <th style="font-size:10px;">Producto</th>
        <th style="font-size:10px;">Cantidad</th>
        <th style="font-size:10px;">Precio</th>
        <th style="font-size:10px;">Descuento</th>
        <th style="font-size:10px;">Iva %</th>
        <th style="font-size:10px;">Total IVA</th>
        <th style="font-size:10px;">Subtotal</th>
      </tr>
      {% for producto in productos %}
      <tr>
        <td style="font-size:10px;">{{producto.producto.codigo ?? '-'}}</td>
        <td style="font-size:10px;">{{producto.producto.descripcion}}</td>
        <td style="font-size:10px;">{{producto.cantidad | number_format(2, ',', '.') }}</td>
        <td style="font-size:10px;">$ {{producto.precioUnitario | number_format(2, ',', '.') }}</td>
        <td style="font-size:10px;">$ {{producto.bonificacion | number_format(2, ',', '.') }}</td>
        <td style="font-size:10px;">{{producto.tipoAlicuota ? producto.tipoAlicuota.descripcion : '--'}}</td>
        <td style="font-size:10px;">$ {{producto.montoIva | number_format(2, ',', '.') }}</td>
        <td style="font-size:10px;">$ {{producto.subtotal | number_format(2, ',', '.') }}</td>

      </tr>
    {% endfor %}
    </table>

    </body>
</html>
